{
  "name": "countdown-modulo",
  "description": "Countdown timer module for Lumen with presenter/overlay output, live styling preview, time triggers, bundled & library audio, queue integration, corner/fullscreen modes, timer presets, and Commander quick controls. Supports English and Portuguese (pt-BR).",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lumen-module dev",
    "build": "lumen-module build",
    "pack": "lumen-module build && lumen-module pack",
    "sync-manifest": "node scripts/sync-manifest.js",
    "version": "pnpm run sync-manifest && git add manifest.json",
    "validate": "lumen-module validate",
    "check": "biome lint .",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format . --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "polished": "^4.3.1",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@lumen-media/module-cli": "^0.3.3",
    "@lumen-media/module-sdk": "^0.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
